#!/usr/bin/env bash
#
# pre-push hook — block a push when the shared JSON-Schema contract files have
# drifted across services. Enable with:
#     git config core.hooksPath scripts/hooks
#
# Bypass (discouraged) for a single push with:
#     git push --no-verify
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if [[ -x "$ROOT/check-schemas.sh" ]]; then
  if ! "$ROOT/check-schemas.sh"; then
    echo
    echo "Push aborted: shared schemas are out of sync (see above)."
    echo "Run ./sync-schemas.sh, commit, and push again."
    exit 1
  fi
fi

exit 0
